# Unity generated folders (rebuilt automatically, never commit these)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE / solution files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash / build leftovers
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Windows builds made into the project folder
/*_Data/
/MonoBleedingEdge/
/D3D12/
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/
/*.exe
/*.dll
/UnityCrashHandler*.exe
