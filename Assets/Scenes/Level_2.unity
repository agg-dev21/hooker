  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9a08d67de93c5f408c8a6ba708b37e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JailCell
  bars: {fileID: 613988867}
  prisoner: {fileID: 98897130}
  prompt: {fileID: 203585482}
  barsRise: 4
  openTime: 0.8
  joinMessage: 'Ariel joins you! Press {key}, then click where her light falls.

    Tap: 3 quick beams.  Hold: one big beam.  No click: she picks.'
  lines:
  - speaker: Ariel
    text: Finally! Do you know how long I've been in here?
  - speaker: Raphael
    text: Long enough to need a bath?
  - speaker: Ariel
    text: ...You're not a guard. Or a lizard. That's a start.
  - speaker: Raphael
    text: I'm looking for my father. Four names left on my list of suspects.
  - speaker: Ariel
    text: Then you need someone watching your back. I'm coming with you.
  - speaker: Ariel
    text: When it gets dangerous I'll stay out of sight. Call me, and I'll bring the light.
