  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneDialogue
  delay: 0.6
  lines:
  - speaker: Madame O
    text: Your mother was the love of my life. For about three weeks.
  - speaker: Raphael
    text: Then you can't be my father.
  - speaker: Madame O
    text: Sweetie, with your mother, I stopped asking how things work.
  - speaker: Oscar
    text: Ssssurprise. Round two.
