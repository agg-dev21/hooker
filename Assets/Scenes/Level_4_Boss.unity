  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneDialogue
  delay: 0.6
  lines:
  - speaker: KK
    text: I know why you're here, son.
  - speaker: Raphael
    text: So it's true.
  - speaker: KK
    text: I wanted to tell you. I just... let you fight three of her exes instead.
  - speaker: Raphael
    text: Where is she?
  - speaker: KK
    text: Get past me first.
